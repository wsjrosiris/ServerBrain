[Unit]
Description=ServerBrain Control Plane
After=network-online.target
Wants=network-online.target

[Service]
User=serverbrain
WorkingDirectory=/var/lib/serverbrain
ExecStart=/usr/local/bin/sb-server -addr :8443 -db /var/lib/serverbrain/serverbrain.db \
  -tls-cert /etc/serverbrain/tls.crt -tls-key /etc/serverbrain/tls.key \
  -policy /etc/serverbrain/policy.json
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/serverbrain

[Install]
WantedBy=multi-user.target
